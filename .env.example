# Copy to .env and fill in your values. NEVER commit .env to version control.

# Flask session secret – generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_STRING

# MongoDB connection string
# Local:   mongodb://localhost:27017/computerclub
# Atlas:   mongodb+srv://user:pass@cluster.mongodb.net/computerclub
MONGO_URI=mongodb://localhost:27017/computerclub

# Admin credentials (set once via init_db.py or environment)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Unique secret access key required at login (third factor)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_ACCESS_KEY=REPLACE_WITH_GENERATED_KEY

# Upload configuration
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=32

# Set to true only for local development
FLASK_DEBUG=false
PORT=5000
